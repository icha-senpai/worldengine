{
  "name": "fishing-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/generated"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @fishing-game/web --",
    "check": "npm run check:scripts && npm run check --workspace @fishing-game/web",
    "check:scripts": "tsc --project scripts/tsconfig.json",
    "build": "npm run build --workspace @fishing-game/web",
    "preview": "npm run preview --workspace @fishing-game/web --",
    "web:publish": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/publish-web.ps1",
    "assets:manifest": "node scripts/asset-manifest.mjs",
    "content:validate": "node content/validate.mjs",
    "module:build": "node scripts/rust-workflow.mjs module",
    "bindings": "node scripts/rust-workflow.mjs script scripts/generate-bindings.mjs",
    "rust:build": "node scripts/rust-workflow.mjs services",
    "rust:run": "node scripts/rust-workflow.mjs cargo",
    "rust:script": "node scripts/rust-workflow.mjs script",
    "rust:check": "node scripts/rust-workflow.mjs cargo check --workspace --locked",
    "rust:test": "node scripts/rust-workflow.mjs cargo test -p game-rules --locked",
    "test:rust-workflow": "node --test scripts/rust-build.test.mjs",
    "test:module": "node scripts/rust-workflow.mjs script scripts/module-tests.mjs",
    "test:subscriptions": "node scripts/subscriptions.test.mjs",
    "test:connection-lifecycle": "node scripts/connection-lifecycle.test.mjs",
    "test:server-clock": "node tests/server-clock.test.mjs",
    "test:load": "node --import tsx tests/load-fishing.mjs",
    "test:integration": "node scripts/rust-workflow.mjs script scripts/run-integration.mjs",
    "test:quests": "node scripts/quest-catalog.test.mjs && node scripts/rust-workflow.mjs script scripts/quests-proof.ts",
    "service:create": "tsx scripts/create-service.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
