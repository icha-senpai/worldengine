VITE_SPACETIMEDB_HOST=ws://127.0.0.1:3100
VITE_BITCRAFT_DATABASE=space-bitcraft-tools
VITE_EVERGATHER_DATABASE=space-evergather
# Temporary local play bypass; also enable it on the database with spacetime:local.
VITE_EVERGATHER_LOCAL_PLAY=false
# Shared Fishbound OAuth service; leave empty until its Evergather configuration
# and the additive account module have been activated. Anonymous guests still
# require VITE_EVERGATHER_LOCAL_PLAY=true and configure_local_play true.
VITE_EVERGATHER_ACCOUNT_LINK_URL=
VITE_AUTH_AUTHORITY=https://auth.spacetimedb.com/oidc
# Public SpacetimeAuth client ID, not a secret. Configure only Discord in its dashboard.
VITE_AUTH_CLIENT_ID=
